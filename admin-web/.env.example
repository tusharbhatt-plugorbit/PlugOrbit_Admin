# Copy to admin-web/.env.local. These values end up in the browser bundle: never put a secret here.

# Empty = same origin (Vite dev proxy to :8000, or a Firebase Hosting rewrite to the API in production).
VITE_API_BASE_URL=

# Google Maps JavaScript API *browser* key. Restrict it in Google Cloud by HTTP referrer and by API
# (Maps JavaScript API only). Without it the Map screens show a configuration notice and a schematic map.
VITE_GOOGLE_MAPS_API_KEY=
# Optional. Advanced Markers need a Map ID; DEMO_MAP_ID works for development only.
VITE_GOOGLE_MAPS_MAP_ID=

# Firebase web app config (public identifiers, not secrets). Set all four to enable real sign-in;
# leave them empty to use the demo role picker (needs ADMIN_DEV_AUTH=true on the API).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
