# Copy to backend/.env for local work. Never commit a real .env or a service-account key.

# development | test | staging | production. staging/production refuse unsafe settings at startup.
ENVIRONMENT=development

# Same variable (and key file) as the mobile Backend: one Firebase project serves both.
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# auto      -> Firestore if the key exists, otherwise the in-memory DEMO store (development/test only)
# memory    -> always the demo store (seeded with clearly-marked fictional data)
# firestore -> always Firestore; with no key file it uses Application Default Credentials (Cloud Run)
DATA_BACKEND=auto
SEED_DEMO_DATA=true

# Emails that may bootstrap themselves as Super Admin on first Firebase sign-in.
BOOTSTRAP_SUPER_ADMIN_EMAILS=you@example.com

# DEVELOPMENT ONLY: demo role-picker sign-in when Firebase Auth is not configured.
# Must be false in staging/production (the API refuses to start otherwise).
ADMIN_DEV_AUTH=false
ADMIN_DEV_SECRET=

# Exact admin web origin(s). A wildcard is rejected in production.
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
